#!/usr/bin/env sh
set -eu

usage() {
  printf 'Usage: %s <skill-directory>\n' "$0" >&2
  printf 'Validates a Codex skill by running quick_validate.py through python3.\n' >&2
}

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

skill_dir=$1
if [ ! -d "$skill_dir" ]; then
  printf 'Skill directory not found: %s\n' "$skill_dir" >&2
  exit 2
fi

validator=${QUICK_VALIDATE_PY:-}
if [ -z "$validator" ]; then
  codex_home=${CODEX_HOME:-"$HOME/.codex"}
  validator=$codex_home/skills/.system/skill-creator/scripts/quick_validate.py
fi

if [ ! -f "$validator" ]; then
  printf 'quick_validate.py not found: %s\n' "$validator" >&2
  printf 'Set CODEX_HOME or QUICK_VALIDATE_PY to the validator path.\n' >&2
  exit 127
fi

python_bin=${PYTHON_BIN:-python3}
exec "$python_bin" "$validator" "$skill_dir"
